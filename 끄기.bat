:start
cd /d "%~dp0program"
if not exist "bootstrap.py" goto nofolder
call "tools\python.cmd" noinstall
if not defined FS_PY if exist ".venv\Scripts\python.exe" set FS_PY=".venv\Scripts\python.exe"
if not defined FS_PY goto nopython
%FS_PY% bootstrap.py stop & exit /b

:nofolder
echo.
echo   [!] The "program" folder is missing.
echo       Unzip the whole download into one folder, then run this file
echo       from inside that folder.
echo.
pause
exit /b

:nopython
echo.
echo   Nothing to stop: no Python found, so the watcher is not running.
pause
exit /b

